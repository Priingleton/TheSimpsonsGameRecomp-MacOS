gamedata_extracting/
gamedata_clean_extract/
extracted/
**/userdata/
**/shots/
*.iso
*.xiso
*.img
*.xex
*.360
*.bin
default.xex
# extracted guest shader microcode (dump_shaders debug cvar output) —
# the game's own copyrighted shader bytecode, not project source
shader_dumps/

# Prebuilt toolchains / SDK binaries (downloaded separately, multi-GB)
tools/clang20/
tools/rexglue-bin/
tools/runtime-staging/

# Vendored PySide6+QtWebEngine for the Linux/Windows launcher (~500MB).
# Rebuild with: pip install --target=launcher/vendor PySide6
launcher/vendor/

# Build outputs
simpsons/out/
tools/rexglue-sdk/build/
tools/rexglue-sdk/out/
tools/XenonRecomp/build/
tools/extract-xiso/build/
build/
dist/
*.o
*.so.orig
*.so.bak*
*.bak-*
*.dmg
*.app

# Electron launcher dependencies and local pack output
macos/electron-launcher/node_modules/
macos/electron-launcher/out/
macos/*.log

# Launcher user-local state (generated from the player's own files)
launcher/art/
launcher/backups/
launcher/mods/
launcher/icon.png
launcher/launcher.json
launcher/__pycache__/
__pycache__/

# Logs, captures, scratch, analysis debris
*.log
logs/
analysis/
