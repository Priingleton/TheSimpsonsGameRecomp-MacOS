{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "mac-arm64-release",
            "displayName": "macOS arm64 Release",
            "description": "Native macOS arm64 build using REXGLUE_MAC_SDK (SDL3 + MoltenVK)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0",
                "CMAKE_PREFIX_PATH": "$env{REXGLUE_MAC_SDK}",
                "rexglue_DIR": "$env{REXGLUE_MAC_SDK}/lib/cmake/rexglue",
                "REXGLUE_HOST_TOOL": "$env{REXGLUE_HOST_TOOL}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "mac-arm64-relwithdebinfo",
            "displayName": "macOS arm64 RelWithDebInfo",
            "inherits": "mac-arm64-release",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "mac-arm64-release",
            "configurePreset": "mac-arm64-release"
        },
        {
            "name": "mac-arm64-relwithdebinfo",
            "configurePreset": "mac-arm64-relwithdebinfo"
        }
    ]
}
